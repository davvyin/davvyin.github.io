DJANGO_DEBUG=false
# Generate separate values with: python3 -c 'import secrets; print(secrets.token_hex(32))'
DJANGO_SECRET_KEY=replace-with-generated-secret
# Use a generated hexadecimal value (safe to embed in DATABASE_URL).
POSTGRES_PASSWORD=replace-with-generated-password
DJANGO_ALLOWED_HOSTS=portfolio.example.com,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://portfolio.example.com
DJANGO_SECURE_SSL_REDIRECT=true
# For the localhost-only Compose port behind your trusted HTTPS reverse proxy.
DJANGO_TRUST_PROXY=true
DJANGO_SECURE_HSTS_SECONDS=31536000
