# Replace PI_LAN_IP with the Pi's private IPv4 address; reserve it in your router.
# This HTTP configuration is for a trusted local network only.
server {
    listen PI_LAN_IP:80;
    server_name raspberrypi.local PI_LAN_IP;

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_redirect off;
    }
}
